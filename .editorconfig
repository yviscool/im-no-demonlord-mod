root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
trim_trailing_whitespace = true

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.{png,jpg,ico,syso,exe,zip}]
charset = unset
end_of_line = unset
insert_final_newline = unset
